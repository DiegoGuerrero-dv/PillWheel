# Copia este archivo a `.env` y cambiá los valores.
# `.env` está en .gitignore: cada persona del repo pone sus propias credenciales.
# Sin `.env`, el server usa los defaults de desarrollo (admin1234 / dev-local-token)
# y lo avisa por consola.

ADMIN_PASSWORD=cambia-esto
DEV_TOKEN=cambia-esto
PORT=8000
